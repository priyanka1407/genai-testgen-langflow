# LLM - the provider follows the model name (claude-* or gemini-*)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
TESTGEN_MODEL=claude-opus-5-5
# TESTGEN_MODEL=gemini-3.8-flash
TESTGEN_OFFLINE=false

# JIRA - used to READ epics/stories (--epic-source jira, or "Live JIRA" in the Epic Reader node)
# and to PUBLISH test cases (--jira). Cloud: JIRA_USER = your email + JIRA_API_TOKEN.
# Server/Data Center: leave JIRA_USER empty and set JIRA_PAT (personal access token).
JIRA_URL=https://your-company.atlassian.net
JIRA_USER=
JIRA_API_TOKEN=
JIRA_PAT=
# Optional: id of a dedicated acceptance-criteria field (auto-detected by name if empty)
JIRA_AC_FIELD=
JIRA_PROJECT=QA
JIRA_ISSUE_TYPE=Task
JIRA_APPROVED_STATUS=Approved
